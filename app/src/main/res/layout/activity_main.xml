<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen"
    android:fitsSystemWindows="true"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header"
            android:orientation="vertical"
            android:padding="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_icon_circle">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_translate"
                        android:tint="@color/brand" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="מתרגם מסך"
                        android:textColor="#FFFFFF"
                        android:textSize="23sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="כל מה שעל המסך – בעברית"
                        android:textColor="#D6F0E6"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/toggleRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_row"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="כפתור תרגום"
                    android:textColor="@color/ink"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/toggleState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:text="כבוי"
                    android:textColor="@color/ink_soft"
                    android:textSize="13sp" />

                <Switch
                    android:id="@+id/bubbleSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:contentDescription="הפעל כפתור תרגום"
                    android:thumbTint="#FFFFFF"
                    android:trackTint="@color/switch_track"
                    android:trackTintMode="src_over" />
            </LinearLayout>
        </LinearLayout>

        <!-- Camera -->
        <LinearLayout
            android:id="@+id/cameraButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_pill_brand"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_camera" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="צלם ותרגם"
                android:textColor="#FFFFFF"
                android:textSize="17sp" />
        </LinearLayout>

        <!-- Language of text in photos and on screen -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="22dp"
            android:text="השפה בתמונות ובמסך"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/modeLatin"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:stateListAnimator="@null"
                android:text="אנגלית / סינית"
                android:textAllCaps="false"
                android:textSize="15sp" />

            <Button
                android:id="@+id/modeArabic"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:stateListAnimator="@null"
                android:text="ערבית"
                android:textAllCaps="false"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="8dp"
            android:text="בטקסט מסומן או משותף השפה מזוהה לבד."
            android:textColor="@color/ink_soft"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="14dp"
            android:textColor="@color/brand"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Offline banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_offline"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_wifi_off" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="עובד בלי אינטרנט – אנגלית, סינית וערבית לעברית"
                android:textColor="#5C3D00"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="20dp"
            android:lineSpacingExtra="5dp"
            android:text="• בחלון האישור של אנדרואיד בחר &quot;כל המסך&quot;\n• הקשה על &quot;תרגם&quot; – תרגום כל המסך\n• לחיצה ארוכה על &quot;תרגם&quot; – תרגום אזור, תרגום חי, שפה, כיבוי\n• סימון טקסט בכל אפליקציה ← &quot;תרגם לעברית&quot;\n• שיתוף טקסט או תמונה ← &quot;תרגם לעברית&quot;\n• אפשר להוסיף כפתור &quot;מתרגם מסך&quot; להגדרות המהירות"
            android:textColor="@color/ink_soft"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
