<?xml version="1.0" encoding="utf-8"?>
<!--
  Laid out like Google Translate: a big text area on top, the language pair under it,
  and three round buttons at the bottom (picture · translate the screen · camera).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen"
    android:fitsSystemWindows="true"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <!-- ============================================================ text area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_text_sheet"
        android:elevation="2dp"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/appTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/app_name"
                    android:textColor="@color/ink"
                    android:textSize="26sp" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/helpButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|top"
                android:layout_marginTop="4dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="איך משתמשים"
                android:src="@drawable/ic_help"
                android:tint="@color/ink_soft" />
        </FrameLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="20dp"
                android:paddingEnd="12dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/sourceText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@null"
                        android:gravity="start|top"
                        android:hint="כאן אפשר לתרגם טקסט"
                        android:importantForAutofill="no"
                        android:inputType="textMultiLine|textCapSentences"
                        android:lineSpacingExtra="2dp"
                        android:minHeight="96dp"
                        android:textColor="@color/ink"
                        android:textColorHint="@color/hint"
                        android:textDirection="anyRtl"
                        android:textSize="30sp" />

                    <ImageButton
                        android:id="@+id/clearButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="נקה"
                        android:src="@drawable/ic_close"
                        android:tint="@color/ink_soft"
                        android:visibility="invisible" />
                </LinearLayout>

                <!-- Translation: shown once there is text -->
                <LinearLayout
                    android:id="@+id/resultBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:background="@color/line" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="עברית"
                        android:textColor="@color/accent"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/translatedText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/accent"
                        android:textDirection="rtl"
                        android:textIsSelectable="true"
                        android:textSize="28sp" />

                    <LinearLayout
                        android:id="@+id/resultActions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/copyButton"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:contentDescription="העתק את התרגום"
                            android:src="@drawable/ic_copy"
                            android:tint="@color/ink_soft" />

                        <ImageButton
                            android:id="@+id/shareButton"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:contentDescription="שתף את התרגום"
                            android:src="@drawable/ic_share"
                            android:tint="@color/ink_soft" />

                        <TextView
                            android:id="@+id/resultStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:textColor="@color/ink_soft"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_handle" />
    </LinearLayout>

    <!-- ============================================================ language pair -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp">

        <!-- Source language (English / Chinese / Arabic), used everywhere; tap to choose. -->
        <Button
            android:id="@+id/sourceLanguage"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:background="@drawable/bg_lang_pill"
            android:stateListAnimator="@null"
            android:text="אנגלית"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="17sp" />

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:importantForAccessibility="no"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_to_target"
            android:tint="@color/ink_soft" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:background="@drawable/bg_lang_pill"
            android:gravity="center"
            android:text="עברית"
            android:textColor="@color/ink"
            android:textSize="17sp" />
    </LinearLayout>

    <!-- ============================================================ round buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="22dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <!-- Right: a picture from the gallery -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/imageButton"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_circle"
                android:contentDescription="תרגם תמונה"
                android:src="@drawable/ic_image"
                android:tint="@color/on_circle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:importantForAccessibility="no"
                android:text="תמונה"
                android:textColor="@color/ink_soft"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Middle: the floating button that translates whatever is on the screen -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/screenButton"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/bg_circle_inverse"
                android:contentDescription="תרגום מסך"
                android:elevation="4dp"
                android:padding="28dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_screen"
                android:tint="@color/on_inverse" />

            <TextView
                android:id="@+id/screenState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:importantForAccessibility="no"
                android:text="תרגום מסך"
                android:textColor="@color/ink"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Left: camera -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/cameraButton"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_circle"
                android:contentDescription="צלם ותרגם"
                android:src="@drawable/ic_camera"
                android:tint="@color/on_circle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:importantForAccessibility="no"
                android:text="מצלמה"
                android:textColor="@color/ink_soft"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
